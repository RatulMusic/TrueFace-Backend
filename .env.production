# TrueFACE Backend Production Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false

# Security Configuration
API_KEY=trueface_secure_api_key_2024_change_in_production
ENABLE_API_KEY_AUTH=true
MAX_CONNECTIONS_PER_IP=3
SECURE_HEADERS=true

# CORS Configuration (CHANGE THESE TO YOUR ACTUAL DOMAINS)
ALLOWED_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Processing Limits
MAX_FRAME_SIZE=5242880
MAX_AUDIO_SIZE=10485760
SESSION_TIMEOUT_MINUTES=30
MAX_SESSIONS=50

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=25

# Model Configuration
MODEL_DEVICE=cpu
VIDEO_WEIGHT=0.6
AUDIO_WEIGHT=0.4
TEMPORAL_SMOOTHING_ALPHA=0.3
CONFIDENCE_THRESHOLD=0.7

# Logging Configuration
LOG_LEVEL=WARNING

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# Cloud Deployment
CLOUD_PROVIDER=render
